PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_KEY=replace-me
PAPERCLIP_CTO_AGENT_ID=00000000-0000-0000-0000-000000000000
# PAPERCLIP_COMPANY_ID=...
PAPERCLIP_WATCHER_POLL_INTERVAL_MS=15000
PAPERCLIP_WATCHER_REQUEST_TIMEOUT_MS=10000
PAPERCLIP_WATCHER_PAGE_SIZE=500
PAPERCLIP_WATCHER_IDLE_GRACE_MS=60000
PAPERCLIP_WATCHER_COOLDOWN_MS=300000
# Opt-in: install a native Paperclip CEO Task Watchdog on each uncovered,
# nonterminal CTO task tree (including standalone tasks).
PAPERCLIP_WATCHER_TASK_WATCHDOG_ENABLED=false
# Optional: inferred if exactly one CEO agent exists in the company.
# PAPERCLIP_CEO_AGENT_ID=00000000-0000-0000-0000-000000000000
PAPERCLIP_WATCHER_TASK_WATCHDOG_SCAN_INTERVAL_MS=60000
PAPERCLIP_WATCHER_TASK_WATCHDOG_MAX_ATTACHMENTS_PER_POLL=1
# Optional: use custom instructions; leave unset for the built-in safe review mandate.
# PAPERCLIP_WATCHER_TASK_WATCHDOG_INSTRUCTIONS=Verify stopped CTO work against evidence.
# PAPERCLIP_WATCHER_DRY_RUN=true
PAPERCLIP_WATCHER_EXPORT_HTTP_ENABLED=true
PAPERCLIP_WATCHER_EXPORT_PASSWORD=replace-with-a-long-random-password
PAPERCLIP_WATCHER_EXPORT_BIND_HOST=127.0.0.1
PAPERCLIP_WATCHER_EXPORT_KEEP=5
# PAPERCLIP_WATCHER_EXPORT_DIR=/path/to/exports
# PAPERCLIP_HOME=~/.paperclip
# PAPERCLIP_INSTANCE_ID=default
# PAPERCLIP_CONFIG=~/.paperclip/instances/default/config.json
