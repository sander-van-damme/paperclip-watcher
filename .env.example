# Base URL of the Paperclip server. Do not include /api at the end.
PAPERCLIP_API_URL=http://127.0.0.1:3100

# Bearer credential with permission to:
# - read company blocked-attention issues
# - read issue recovery actions
# - create issues and assign them to the CEO
# A board/operator credential is the safest choice. An agent credential must
# have the corresponding task assignment authority.
PAPERCLIP_API_KEY=replace-me

# UUID of the CEO agent that should handle missing-disposition recoveries.
PAPERCLIP_CEO_AGENT_ID=00000000-0000-0000-0000-000000000000

# Optional. If omitted, the watcher derives the company from GET /api/agents/:id.
# PAPERCLIP_COMPANY_ID=00000000-0000-0000-0000-000000000000

# Optional tuning.
PAPERCLIP_WATCHER_POLL_INTERVAL_MS=15000
PAPERCLIP_WATCHER_REQUEST_TIMEOUT_MS=10000
PAPERCLIP_WATCHER_PAGE_SIZE=100
# PAPERCLIP_WATCHER_DRY_RUN=true
